{
  "name": "@subboost/local",
  "version": "2.11.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "clean": "node scripts/clean-next.cjs",
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3001",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prelint": "node scripts/ensure-root-node-modules.cjs",
    "lint": "eslint app src --max-warnings=0",
    "pretypecheck": "node scripts/ensure-root-node-modules.cjs && npm run clean",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit -p tsconfig.json",
    "prebuild": "node scripts/ensure-root-node-modules.cjs && npm run clean",
    "build": "npm run db:generate && next build --webpack",
    "start": "node scripts/start-standalone.cjs",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@subboost/config": "file:../packages/config",
    "@subboost/core": "file:../packages/core",
    "@subboost/server-core": "file:../packages/server-core",
    "@subboost/ui": "file:../packages/ui",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "jose": "^6.2.13",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "peggy": "^5.1.1",
    "prisma": "^7.10.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-remove-scroll-bar": "^2.3.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
